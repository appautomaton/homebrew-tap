#!/bin/bash
set -euo pipefail

formula_path="Formula/docker-for-apple-container.rb"
tap_owner="appautomaton"
tap_repo="homebrew-tap-validation"
tap_name="${tap_owner}/tap-validation"
formula_name="${tap_name}/docker-for-apple-container"

if [[ ! -f "$formula_path" ]]; then
  printf 'formula not found: %s\n' "$formula_path" >&2
  exit 1
fi

checkout_path=$(pwd -P)
brew_repository=$(brew --repository)
tap_parent="${brew_repository}/Library/Taps/${tap_owner}"
tap_path="${tap_parent}/${tap_repo}"

if [[ -e "$tap_path" || -L "$tap_path" ]]; then
  printf 'temporary validation tap already exists: %s\n' "$tap_path" >&2
  exit 1
fi

mkdir -p "$tap_parent"
ln -s "$checkout_path" "$tap_path"

cleanup() {
  brew untrust --tap "$tap_name" >/dev/null 2>&1 || true
  if [[ -L "$tap_path" && "$(readlink "$tap_path")" == "$checkout_path" ]]; then
    rm "$tap_path"
  fi
}
trap cleanup EXIT

# Homebrew refuses to load formulae from taps the user has not trusted.
brew trust --tap "$tap_name"

brew style "$formula_path"
brew audit --strict --online "$formula_name"
brew livecheck "$formula_name" --json
